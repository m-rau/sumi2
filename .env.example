# MongoDB
MONGODB_URI=mongodb://localhost:27018
MONGODB_DATABASE=sumi2

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Admin Bootstrap (optional - if not set, random password will be generated)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin

# SMTP / Email (optional - if not set, password reset emails won't be sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_USE_TLS=true

# Password Reset
PASSWORD_RESET_EXPIRE_MINUTES=120
FRONTEND_URL=http://localhost:5173
